# --- Local database (default); Supabase credentials are for export/fallback only ---
LIAINNE_DATA_BACKEND=sqlite
# LIAINNE_JOURNAL_DB=/absolute/path/to/journal.sqlite3
SUPABASE_URL=your-supabase-project-url-here
SUPABASE_KEY=your-supabase-service-role-key-here

# --- Explicit local AI (off until enabled in Settings) ---
LOCAL_AI_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_NUM_CTX=4096
OLLAMA_KEEP_ALIVE=5m
# Set OLLAMA_NO_CLOUD=1 in the environment of the Ollama service itself.
