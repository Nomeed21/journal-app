-- Main quest board table
CREATE TABLE IF NOT EXISTS public.board_quests (
    id                BIGSERIAL PRIMARY KEY,
    title             TEXT NOT NULL,
    description       TEXT DEFAULT '',
    difficulty        TEXT DEFAULT 'Normal',
    section           TEXT DEFAULT 'daily',      -- recommended | daily | weekly | skill | recovery | boss | completed
    source_type       TEXT DEFAULT 'manual',     -- manual | skill | goal | milestone | habit | journal | boss
    source_id         TEXT DEFAULT '',           -- dedup key (e.g. "skill:cs_python", "habit:Running:2024-01-15")
    category          TEXT DEFAULT 'Personal Growth',
    xp_reward         INTEGER DEFAULT 50,
    is_completed      BOOLEAN DEFAULT FALSE,
    completed_at      TIMESTAMPTZ,
    due_date          DATE,
    parent_quest_id   BIGINT REFERENCES public.board_quests(id) ON DELETE SET NULL,
    goal_id           BIGINT REFERENCES public.goals(id) ON DELETE SET NULL,
    milestone_id      BIGINT REFERENCES public.goal_milestones(id) ON DELETE SET NULL,
    suggested_tasks   TEXT DEFAULT '[]',         -- JSON array of task title strings
    unlocked_at       TIMESTAMPTZ,
    created_at        TIMESTAMPTZ DEFAULT NOW()
);

-- Tasks belonging to board quests
CREATE TABLE IF NOT EXISTS public.board_quest_tasks (
    id            BIGSERIAL PRIMARY KEY,
    quest_id      BIGINT NOT NULL REFERENCES public.board_quests(id) ON DELETE CASCADE,
    title         TEXT NOT NULL,
    is_completed  BOOLEAN DEFAULT FALSE,
    created_at    TIMESTAMPTZ DEFAULT NOW()
);

-- Indexes for common query patterns
CREATE INDEX IF NOT EXISTS idx_board_quests_section
    ON public.board_quests(section);

CREATE INDEX IF NOT EXISTS idx_board_quests_source
    ON public.board_quests(source_type, source_id);

CREATE INDEX IF NOT EXISTS idx_board_quests_completed
    ON public.board_quests(is_completed);

CREATE INDEX IF NOT EXISTS idx_board_quests_parent
    ON public.board_quests(parent_quest_id);

CREATE INDEX IF NOT EXISTS idx_board_quest_tasks_quest
    ON public.board_quest_tasks(quest_id);

-- Unique constraint to prevent duplicate quests from the same source
-- (source_id is '' for manual quests so we only enforce when it's non-empty)
CREATE UNIQUE INDEX IF NOT EXISTS idx_board_quests_source_dedup
    ON public.board_quests(source_type, source_id)
    WHERE source_id != '';

