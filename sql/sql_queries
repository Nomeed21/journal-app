-- Discovery persistence — snapshot-on-change history for the
-- auto-discovery feed (see _record_discovery_snapshot /
-- _discovery_delta / _get_discoveries_for_month in main.py)
-- ────────────────────────────────────────────────────────────

create table if not exists discoveries (
    id            bigint generated always as identity primary key,
    discovery_id  text    not null,          -- e.g. 'completion_rate:Study', 'peak:mood', 'mood_after:Meditation'
    kind          text    not null default '',  -- category_completion_rate | time_of_day_peak | mood_after_habit
    category      text    not null default '',
    value         numeric not null,          -- the single trackable number for this discovery
    snapshot      jsonb   default '{}',      -- {"title": ..., "detail": ...} at the time this was recorded
    recorded_at   timestamptz default now()
    -- deliberately no unique constraint: this table accumulates history,
    -- one row per change, not one row per discovery_id.
);

create index if not exists idx_discoveries_id_time on discoveries(discovery_id, recorded_at desc);
create index if not exists idx_discoveries_recorded_at on discoveries(recorded_at);

