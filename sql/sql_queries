create or replace function match_entries(
  query_embedding extensions.vector(384),
  match_threshold float,
  match_count int
)
returns table (
  id bigint,
  title text,
  content text,
  mood int,
  goal_progress int,
  created_at timestamptz,
  similarity float
)
language plpgsql
as $$
begin
  return query
  select
    journal_entries.id,
    journal_entries.title,
    journal_entries.content,
    journal_entries.mood,
    journal_entries.goal_progress,
    journal_entries.created_at,
    1 - (journal_entries.embedding <=> query_embedding) as similarity
  from journal_entries
  where 1 - (journal_entries.embedding <=> query_embedding) > match_threshold
  order by journal_entries.embedding <=> query_embedding
  limit match_count;
end;
$$;



create table journal_entries (
  id bigint generated always as identity primary key,
  title text,
  content text,
  mood int,
  goal_progress int,
  embedding extensions.vector(384),
  created_at timestamptz default now()
);


