-- ────────────────────────────────────────────────────────────
-- Row Level Security (service_role bypasses RLS by default;
-- these policies matter only if you also call these tables
-- with the anon/authenticated key from client-side code)
-- ────────────────────────────────────────────────────────────

alter table quests                     enable row level security;
alter table habit_profiles             enable row level security;
alter table habit_recovery_tokens_v2   enable row level security;
alter table habit_synergies            enable row level security;

do $$
begin
    if not exists (select 1 from pg_policies where tablename = 'quests' and policyname = 'service_role_all_quests') then
        execute 'create policy service_role_all_quests on quests for all to service_role using (true) with check (true)';
    end if;
    if not exists (select 1 from pg_policies where tablename = 'habit_profiles' and policyname = 'srvc_habit_profiles') then
        execute 'create policy srvc_habit_profiles on habit_profiles for all to service_role using (true) with check (true)';
    end if;
    if not exists (select 1 from pg_policies where tablename = 'habit_recovery_tokens_v2' and policyname = 'srvc_hrt_v2') then
        execute 'create policy srvc_hrt_v2 on habit_recovery_tokens_v2 for all to service_role using (true) with check (true)';
    end if;
    if not exists (select 1 from pg_policies where tablename = 'habit_synergies' and policyname = 'srvc_habit_syn') then
        execute 'create policy srvc_habit_syn on habit_synergies for all to service_role using (true) with check (true)';
    end if;
end
$$;


