-- Enable Row Level Security. Since this is a single-user app using the
-- service-role key (already true for the rest of your tables like
-- journal_entries, goals, etc.), a permissive policy keeps behavior
-- consistent with the rest of the schema. Tighten this if you ever add
-- multi-user auth.
alter table public.books enable row level security;

create policy "Allow all access to books"
    on public.books
    for all
    using (true)
    with check (true);
    

